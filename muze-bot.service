[Unit]
Description=Muze Minecraft bot (Mineflayer) for CT105 Paper server
After=network-online.target minecraft.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/muze-bot
Environment=MC_HOST=127.0.0.1
Environment=MC_PORT=25565
Environment=MC_USER=Muze
Environment=VIEWER_PORT=3007
ExecStart=/usr/bin/node bot.js
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
